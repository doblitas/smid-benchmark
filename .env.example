# Copiar a .env.local (local) o configurar en Vercel → Settings → Environment Variables

# Obligatorio para modo live (Meta / Google)
APIFY_TOKEN=

# Prensa: native (default, HTTP liviano sin Actor) | apify (cheerio-scraper)
PRESS_CAPTURE_MODE=native

# Opcional: IDs de Actors (defaults en código)
APIFY_META_ACTOR_ID=apify/facebook-ads-scraper
APIFY_GOOGLE_ACTOR_ID=curious_coder/google-ads-transparency-scraper
APIFY_PRESS_ACTOR_ID=apify/cheerio-scraper

# Memoria por Actor (MB). Cheerio ~1024; website-content-crawler necesita más.
APIFY_PRESS_MEMORY_MB=1024
APIFY_META_MEMORY_MB=2048
APIFY_GOOGLE_MEMORY_MB=2048
